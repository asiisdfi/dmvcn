  "dependencies": {
    "@lucide/astro": "^1.23.0",
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "fflate": "^0.8.2",
    "parse5": "^8.0.1",
    "sharp": "^0.35.3"
  }
}

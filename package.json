{
  "name": "dmv-cn",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:brand": "node scripts/build-brand-assets.mjs",
    "dev": "astro dev",
    "build": "npm run build:brand && npm run build:site && npm run audit:directory-fingerprints && npm run audit:topic-fingerprints && npm run audit:eeat && npm run build:site",
    "build:site": "astro build",
    "preview": "astro preview",
    "audit:links": "node --experimental-strip-types scripts/audit-official-links.mjs",
    "audit:links:full": "LINK_AUDIT_FORCE=1 LINK_AUDIT_LIMIT=0 node --experimental-strip-types scripts/audit-official-links.mjs",
    "audit:source-freshness": "node --experimental-strip-types scripts/audit-source-freshness.mjs",
    "audit:search-console-import": "node scripts/audit-search-console-import.mjs",
    "audit:search-console": "node scripts/audit-search-console-plan.mjs",
    "audit:growth": "node scripts/audit-growth-scorecard.mjs",
    "audit:pulse": "node --experimental-strip-types scripts/audit-search-console-pulse.mjs",
    "audit:content": "node --experimental-strip-types scripts/audit-content-quality.mjs",
    "audit:directory-evidence": "node --experimental-strip-types scripts/audit-directory-evidence.mjs",
    "audit:directory-fingerprints": "node --experimental-strip-types scripts/audit-high-risk-directory-fingerprints.mjs",
    "audit:topic-fingerprints": "node --experimental-strip-types scripts/audit-high-risk-topic-fingerprints.mjs",
    "audit:state-evidence": "node --experimental-strip-types scripts/audit-state-evidence.mjs",
    "audit:practice": "node --experimental-strip-types scripts/audit-practice-tests.mjs",
    "audit:eeat": "node --experimental-strip-types scripts/audit-eeat.mjs",
    "audit:eeat:strict": "EEAT_STRICT=1 node --experimental-strip-types scripts/audit-eeat.mjs",
    "audit:publication:test": "node --experimental-strip-types scripts/audit-publication-gate-test.mjs",
    "audit:review-cycles": "node scripts/audit-review-cycles.mjs",
    "audit:review-cycles:test": "node scripts/audit-review-cycles-test.mjs",
    "audit:site": "node scripts/audit-site-integrity.mjs",
    "audit:internal-links": "node --experimental-strip-types scripts/audit-internal-link-architecture.mjs",
    "audit:internal-links:test": "node scripts/audit-internal-link-architecture-test.mjs",
    "audit:intent": "node --experimental-strip-types scripts/audit-search-intent-overlap.mjs",
    "audit:intent:test": "node scripts/audit-search-intent-overlap-test.mjs",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:metadata": "node scripts/audit-search-metadata.mjs",
    "audit:launch": "node --env-file-if-exists=.env scripts/audit-launch-config.mjs",
    "audit:performance": "node scripts/audit-mobile-performance.mjs",
    "plan:quality": "node scripts/build-quality-workbook.mjs",
    "plan:review-cycles": "node scripts/build-review-cycle-report.mjs",
    "plan:sc": "node scripts/build-search-console-plan.mjs",
    "plan:growth": "node scripts/build-growth-scorecard.mjs",
    "plan:pulse": "node --experimental-strip-types scripts/build-search-console-pulse.mjs",
    "import:sc": "node scripts/import-search-console-export.mjs",
    "complete:sc-routing": "node scripts/complete-search-console-routing-action.mjs",
    "review:signoffs:import": "node --experimental-strip-types scripts/import-review-signoffs.mjs",
    "verify:launch": "npm run audit:content && npm run audit:practice && npm run build && npm run audit:directory-evidence && npm run audit:state-evidence && npm run audit:eeat && npm run audit:publication && npm run audit:publication:test && npm run audit:site && npm run audit:internal-links && npm run audit:internal-links:test && npm run audit:intent && npm run audit:intent:test && npm run audit:seo && npm run audit:metadata && npm run audit:performance && npm run audit:launch",
    "astro": "astro",
    "plan:signoff": "node --experimental-strip-types scripts/build-signoff-template.mjs",
    "audit:publication": "node --experimental-strip-types scripts/audit-publication-gate.mjs"

---
import { ArrowRight, BadgeCheck, BookOpen, MapPinned } from '@lucide/astro/icons';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="DMV 办事入口"
  description="从州指南、具体办事事项和中文驾照练习进入 DMV中文办事库的主要内容。"
>
  <section class="page-hero">
    <div class="section">
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>办事入口</span></nav>
      <p class="eyebrow">快速入口</p>
      <h1>从你的办事任务开始</h1>
      <p class="lead">先选所在州，或者直接进入 REAL ID、驾照、搬州和车辆手续等具体事项。</p>
    </div>
  </section>

  <section class="section">
    <div class="directory-card-grid">
      <article class="directory-card">
        <MapPinned size={24} aria-hidden="true" />
        <h2>按州查</h2>
        <p>进入 50 州 DMV 总览和州别 REAL ID 材料页。</p>
        <a href="/states/">选择州 <ArrowRight size={16} aria-hidden="true" /></a>
      </article>
      <article class="directory-card">
        <BadgeCheck size={24} aria-hidden="true" />
        <h2>按事项查</h2>
        <p>查 REAL ID、续期补证、地址、考试、车辆登记和常见问题。</p>
        <a href="/topics/">选择事项 <ArrowRight size={16} aria-hidden="true" /></a>
      </article>
      <article class="directory-card">
        <BookOpen size={24} aria-hidden="true" />
        <h2>中文笔试练习</h2>
        <p>按州做练习题，答题后查看中文解释和手册章节。</p>
        <a href="/practice-tests/">开始练习 <ArrowRight size={16} aria-hidden="true" /></a>
      </article>
    </div>
  </section>
</BaseLayout>

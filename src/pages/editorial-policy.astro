---
import { ArrowRight, FileText, ListChecks, MapPinned } from '@lucide/astro/icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  EDITORIAL_AUTHOR,
  EDITORIAL_POLICY_DATE,
  EDITORIAL_POLICY_MODIFIED_DATE,
} from '../data/editorial';

const schema = {
  '@type': 'WebPage',
  name: 'DMV中文办事库内容说明',
  description: 'DMV中文办事库如何组织州级 DMV、REAL ID、驾照和车辆手续信息。',
  url: new URL('/editorial-policy/', Astro.site).toString(),
  datePublished: EDITORIAL_POLICY_DATE,
  dateModified: EDITORIAL_POLICY_MODIFIED_DATE,
  inLanguage: 'zh-Hans',
  author: {
    '@type': 'Organization',
    name: EDITORIAL_AUTHOR.name,
    url: new URL(EDITORIAL_AUTHOR.path, Astro.site).toString(),
  },
  publisher: {
    '@type': 'Organization',
    '@id': new URL('/#organization', Astro.site).toString(),
  },
  isPartOf: {
    '@type': 'WebSite',
    '@id': new URL('/#website', Astro.site).toString(),
  },
};
---

<BaseLayout
  title="内容说明"
  description="DMV中文办事库如何组织州级 DMV、REAL ID、驾照和车辆手续信息。"
  schema={schema}
>
  <section class="page-hero">
    <div class="section">
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>内容说明</span></nav>
      <p class="eyebrow">内容说明</p>
      <h1>围绕实际办事任务整理</h1>
      <p class="lead">每个页面尽量让用户先判断路径，再准备材料，最后进入对应政府系统。</p>
    </div>
  </section>

  <section class="section policy-layout">
    <div class="article-stack">
      <section class="panel">
        <div class="policy-heading"><MapPinned size={22} aria-hidden="true" /><h2>州别优先</h2></div>
        <p>驾照、州身份证、REAL ID、车辆登记和考试规则由各州分别管理。州指南负责说明主管机构、主要入口和常见业务。</p>
      </section>
      <section class="panel">
        <div class="policy-heading"><ListChecks size={22} aria-hidden="true" /><h2>按任务组织</h2></div>
        <p>事项页围绕材料清单、办理顺序、线上与现场分流、州别差异和常见失败原因展开。</p>
      </section>
      <section class="panel">
        <div class="policy-heading"><FileText size={22} aria-hidden="true" /><h2>政府入口</h2></div>
        <p>费用、表格、预约、资格和申请操作都连接到主管政府机构页面，便于直接继续办理。</p>
      </section>
      <nav class="policy-links" aria-label="相关页面">
        <a href="/states/">州指南 <ArrowRight size={15} aria-hidden="true" /></a>
        <a href="/topics/">事项大全 <ArrowRight size={15} aria-hidden="true" /></a>
        <a href="/directories/">政府入口表 <ArrowRight size={15} aria-hidden="true" /></a>
      </nav>
    </div>
  </section>
</BaseLayout>

---
import { ArrowRight } from '@lucide/astro/icons';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/content';
import { EDITORIAL_AUTHOR } from '../../data/editorial';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const schema = {
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Organization',
    name: EDITORIAL_AUTHOR.name,
    url: pageUrl,
    description: 'DMV中文办事库的统一内容署名。',
    memberOf: {
      '@type': 'Organization',
      name: SITE.name,
      url: new URL('/', Astro.site).toString(),
    },
  },
};
---

<BaseLayout
  title="DMVCN 官方整理"
  description="DMVCN 官方整理是 DMV中文办事库用于州指南、事项页和办事入口的统一内容署名。"
  schema={schema}
>
  <section class="page-hero">
    <div class="section">
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><a href="/about/">关于</a><span>/</span><span>DMVCN 官方整理</span></nav>
      <p class="eyebrow">内容署名</p>
      <h1>DMVCN 官方整理</h1>
      <p class="lead">负责把美国 DMV、REAL ID、驾照和车辆手续资料整理成中文办事页面。</p>
    </div>
  </section>

  <section class="section policy-layout">
    <div class="article-stack">
      <section class="panel">
        <h2>整理内容</h2>
        <p>州别入口、材料类别、办理步骤、常见问题、表格与政府服务链接。</p>
      </section>
      <section class="panel">
        <h2>站内分工</h2>
        <p>州指南负责具体州的业务入口，事项页负责跨州问题，入口表用于快速查找预约、考试和材料页面。</p>
      </section>
      <nav class="policy-links" aria-label="相关页面">
        <a href="/about/">关于本站 <ArrowRight size={15} aria-hidden="true" /></a>
        <a href="/contact/">联系 <ArrowRight size={15} aria-hidden="true" /></a>
      </nav>
    </div>
  </section>
</BaseLayout>

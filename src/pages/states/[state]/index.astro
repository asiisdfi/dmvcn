---
import { ArrowRight } from '@lucide/astro/icons';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentMeta from '../../../components/ContentMeta.astro';
import EditorialDisclosure from '../../../components/EditorialDisclosure.astro';
import OfficialLinkButton from '../../../components/OfficialLinkButton.astro';
import NewYorkAssistantEntry from '../../../components/NewYorkAssistantEntry.astro';
import SourceList from '../../../components/SourceList.astro';
import StateEvidenceList from '../../../components/StateEvidenceList.astro';
import {
  SITE,
  getPublicEditorialNotes,
  getStatePublicStatus,
  states,
  topics,
  uniqueSources,
  type StateGuide,
} from '../../../data/content';
import { EDITORIAL_AUTHOR } from '../../../data/editorial';
import { buildStateEvidence, getStatePageModifiedAt } from '../../../data/state-evidence';

export function getStaticPaths() {
  return states.map((state) => ({
    params: { state: state.id },
    props: { state },
  }));
}

const { state } = Astro.props as { state: StateGuide };
const relatedTopics = topics.filter((topic) => state.relatedTopicSlugs.includes(topic.slug));
const accessStatus = state.accessStatus ? getStatePublicStatus(state) : undefined;
const publicNotes = getPublicEditorialNotes(state.editorNotes);
const stateEvidence = buildStateEvidence(state, 'overview', publicNotes);
const coreEvidence = stateEvidence.filter((item) => item.field !== 'editorNotes');
const detailEvidence = stateEvidence.filter((item) => item.field === 'editorNotes');
const featuredDetailEvidence = detailEvidence.slice(0, 6);
const additionalDetailEvidence = detailEvidence.slice(6);
const modifiedAt = getStatePageModifiedAt(state);
const title = state.seoTitle ?? `${state.nameZh} DMV / 驾照 / REAL ID 办事总览`;
const description =
  state.seoDescription ??
  `${state.nameZh} DMV 中文办事总览：官方入口、REAL ID、驾照、地址变更、预约和常见材料提醒。`;
const pageHeading = state.pageHeading ?? `${state.nameZh} DMV 办事总览`;
const officialSources = uniqueSources(state.sources);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const isCountyRouted = state.id === 'hawaii';
const featuredActionLabels = new Set(state.overviewFeaturedActionLabels ?? []);
const featuredActionLinks = (state.overviewFeaturedActionLabels ?? [])
  .map((label) => state.actionLinks.find((link) => link.label === label))
  .filter((link): link is StateGuide['actionLinks'][number] => Boolean(link));
const remainingActionLinks = state.actionLinks.filter((link) => !featuredActionLabels.has(link.label));
const linkLabel = (link: StateGuide['actionLinks'][number]) => link.label.toLowerCase();
const findActionLink = (patterns: RegExp[]) =>
  patterns.map((pattern) => state.actionLinks.find((link) => pattern.test(linkLabel(link)))).find(Boolean);
const newResidentLink = findActionLink([
  /新居民|new .*resident|new to|moving to|搬家/,
  /外州|out[- ]of[- ]state|another state/,
  /license transfers?/,
]);
const serviceLink =
  findActionLink([
    /续期|renew(?:al)?/,
    /补证|replace(?:ment)?|duplicate/,
    /地址|address/,
    /线上.*服务|online.*services?|portal/,
    /预约|appointment/,
  ]) ??
  {
    label: `${state.agency} 服务首页`,
    url: state.agencyUrl,
    description: '从州机构首页选择续期、补证、地址变更或预约服务。',
  };
const newYorkQuickAnswers = state.id === 'new-york'
  ? [
      {
        question: '纽约驾照续期需要预约吗？',
        answer:
          '不一定。已有 REAL ID 或 Enhanced，或者续期后仍保持 Standard，通常可以网上或邮寄办理。升级证件、更新照片或驾照等级、从未取得 SSN、持 CDL，或证件带 Temporary Visitor 日期时，需要到办公室办理。现场业务应先查看具体办公室的预约规则；NY DMV 明确建议提前预约。',
        sources: [
          { label: '驾照续期条件', url: 'https://dmv.ny.gov/driver-license/renew-a-driver-license' },
          { label: '办公室与预约', url: 'https://dmv.ny.gov/contact-us/office-locations' },
        ],
      },
      {
        question: '纽约驾照什么时候能续期，过期了还能续吗？',
        answer:
          '普通续期窗口是到期前 1 年至到期后 2 年。过期满 2 年后不能再走普通续期，需要按首次申请重新完成视力、笔试、课程和路考。',
        sources: [
          { label: 'NY DMV 续期时间', url: 'https://dmv.ny.gov/driver-license/renew-a-driver-license' },
        ],
      },
      {
        question: '纽约驾照或 ID 还没寄到，怎么查？',
        answer:
          'NY DMV 要求先预留 3 周。查询时要准备临时证件上的 Transaction ID，或线上确认邮件里的 confirmation number，再填写交易日期。地址错误、退件或邮寄途中丢失时，可在官方流程中核对地址并申请重新寄送。',
        sources: [
          {
            label: '证件邮寄状态查询',
            url: 'https://dmv.ny.gov/driver-license/check-license-permit-or-non-driver-id-mailing-status',
          },
        ],
      },
      {
        question: '纽约 DMV 有中文电话或免费口译吗？',
        answer:
          '有。需要免费语言协助时可拨打 1-518-486-9786，并说明需要中文服务。NY DMV 将 Chinese 列入重要表格和文件覆盖的主要语言。',
        sources: [
          { label: '语言协助说明', url: 'https://dmv.ny.gov/more-info/language-assistance' },
        ],
      },
      {
        question: '纽约 REAL ID 能全程网上申请吗？',
        answer:
          '不能。首次领取照片证件，或从 Standard 升级为 REAL ID / Enhanced，都要到 DMV office 提交材料。可以先在线使用官方 pre-screening 生成清单、填写可下载申请，并选择在到访前提交材料预审。',
        sources: [
          { label: 'REAL ID / Enhanced 申请', url: 'https://dmv.ny.gov/driver-license/enhanced-or-real-id' },
        ],
      },
    ]
  : [];
const routeCards = [
  {
    number: '01',
    title: '我要办 REAL ID',
    text: '先判断是否真的需要，再按本州材料清单备原件或认证副本。',
    href: `/states/${state.id}/real-id/`,
    action: '看中文清单',
    external: false,
  },
  {
    number: '02',
    title: '我刚搬到这个州',
    text: isCountyRouted
      ? '先按岛屿确认 Honolulu、Maui、Hawaii County 或 Kauai，再查看该县的 transfer 规则。'
      : newResidentLink
      ? /foreign|country/.test(linkLabel(newResidentLink))
        ? newResidentLink.description
        : `从 ${newResidentLink.label} 开始，先确认外州证件、地址证明和是否要预约。`
      : '先看搬州专题，再回到本州 DMV 页面确认 new resident 要求。',
    href: isCountyRouted ? '#official-entry' : newResidentLink?.url ?? '/topics/moving-to-new-state/',
    action: isCountyRouted ? '选择所在县' : newResidentLink ? '打开官方入口' : '看搬州专题',
    external: isCountyRouted ? false : Boolean(newResidentLink),
  },
  {
    number: '03',
    title: state.id === 'new-york' ? '我要续期、预约或查邮寄' : '我要续期、补证或改地址',
    text: state.id === 'new-york'
      ? '按到期时间、证件类型和当前情况，判断网上办理、现场预约或邮寄查询路线。'
      : isCountyRouted
      ? '这些业务和预约都由所在县处理，先从四县入口表选择自己的办理地。'
      : serviceLink
      ? `先处理地址和线上资格，再从 ${serviceLink.label} 进入对应业务。`
      : '先确认地址、证件状态和线上资格，再决定是否需要预约。',
    href: state.id === 'new-york'
      ? '/tools/new-york-dmv-assistant/?task=license-service'
      : isCountyRouted
        ? '#official-entry'
        : serviceLink?.url ?? '/topics/renewal-replacement-address/',
    action: state.id === 'new-york'
      ? '按情况判断'
      : isCountyRouted
        ? '选择所在县'
        : serviceLink
          ? '打开办理入口'
          : '看顺序说明',
    external: state.id === 'new-york' || isCountyRouted ? false : Boolean(serviceLink),
  },
];
const serviceComparisonRows = [
  {
    label: '普通驾照 / 州 ID',
    use: state.licenseSummary,
    next: `${state.agency} 的驾照、ID 或线上服务入口。`,
  },
  {
    label: 'REAL ID',
    use: state.realIdSummary,
    next: `${state.nameZh} REAL ID 中文清单和州官方 REAL ID / 材料入口。`,
  },
  {
    label: '续期 / 补证 / 地址 / 预约',
    use: state.appointmentNote,
    next: isCountyRouted
      ? '先按岛屿选择 Honolulu、Maui、Hawaii County 或 Kauai 的县级业务入口。'
      : serviceLink
        ? `${serviceLink.label}：${serviceLink.description}`
        : '先确认地址、证件状态和线上资格，再看州官方服务入口。',
  },
];
const overviewFaqs = [
  {
    question: '能在这里提交申请、预约或付款吗？',
    answer: `不能。申请、预约、付款、上传文件或更新记录，都要在 ${state.agency} 官方系统完成。`,
  },
  {
    question: `我应该先看 REAL ID 还是普通驾照服务？`,
    answer: `如果你的目标是国内航班安检或部分联邦身份用途，先看 ${state.nameZh} REAL ID 清单；如果只是驾驶、续期、补证或地址变化，先看普通驾照 / ID 和对应服务入口。`,
  },
  {
    question: '官方入口打不开怎么办？',
    answer: accessStatus?.fallbackUrl
      ? `先从备用官方入口进入，再选择 ${state.nameZh} 或 ${state.agency}。部分政府网站会要求验证码，或需要从机构首页重新进入。`
      : `先回到 ${state.agency} 首页，再按 driver license、ID、REAL ID、renewal 或 appointment 等栏目进入。`,
  },
];
const faqSchemaItems = [...newYorkQuickAnswers, ...overviewFaqs];
const schema = [
  {
    '@type': 'Article',
    headline: title,
    description,
    mainEntityOfPage: pageUrl,
    dateModified: modifiedAt,
    datePublished: state.publishedAt,
    inLanguage: 'zh-Hans',
    isAccessibleForFree: true,
    author: {
      '@type': 'Organization',
      name: EDITORIAL_AUTHOR.name,
      url: new URL(EDITORIAL_AUTHOR.path, Astro.site).toString(),
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: new URL('/', Astro.site).toString(),
      logo: new URL('/assets/dmvcn-mark.png', Astro.site).toString(),
    },
    about: [`${state.nameEn} DMV`, `${state.nameEn} driver license`, `${state.nameEn} REAL ID`],
    citation: officialSources.map((source) => source.url),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqSchemaItems.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: '首页',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: '州指南',
        item: new URL('/states/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: state.nameZh,
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  publishedAt={state.publishedAt}
  modifiedAt={modifiedAt}
  reviewedAt={state.reviewedAt}
  schema={schema}
>
  <section class="page-hero">
    <div class="section">
      <nav class="breadcrumbs" aria-label="面包屑">
        <a href="/">首页</a><span>/</span><a href="/states/">州指南</a><span>/</span><span>{state.nameZh}</span>
      </nav>
      <p class="eyebrow">{state.abbr} / {state.agency}</p>
      <h1>{pageHeading}</h1>
      <p class="lead">{state.summary}</p>
      <div class="article-meta">
        <ContentMeta publishedAt={state.publishedAt} modifiedAt={modifiedAt} reviewedAt={state.reviewedAt} />
        <a href="#official-sources">政府链接 <ArrowRight size={15} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <div class="content-layout">
    <article class="article-stack">
      <section class="route-board" aria-labelledby="route-board-title">
        <div class="route-board-head">
          <div>
            <p class="eyebrow">路线板</p>
            <h2 id="route-board-title">先走哪条线</h2>
          </div>
          <p>不用先读完整页。先把自己的情况放进一条路线，再看对应材料和官方入口。</p>
        </div>
        <div class="route-card-grid">
          {routeCards.map((route) => (
            <article class="route-card">
              <span>{route.number}</span>
              <h3>{route.title}</h3>
              <p>{route.text}</p>
              <a class="route-action" href={route.href} target={route.external ? '_blank' : undefined} rel={route.external ? 'noreferrer' : undefined}>
                {route.action} <ArrowRight size={15} aria-hidden="true" />
              </a>
            </article>
          ))}
        </div>
      </section>

      {state.id === 'new-york' && <NewYorkAssistantEntry task="license-service" />}

      {newYorkQuickAnswers.length > 0 && (
        <section class="panel ny-quick-answers" aria-labelledby="ny-quick-answers-title">
          <p class="eyebrow">纽约 DMV 快答</p>
          <h2 id="ny-quick-answers-title">续期、预约、邮寄和中文服务</h2>
          <div class="faq-list">
            {newYorkQuickAnswers.map((item) => (
              <article class="faq-item ny-quick-answer">
                <h3>{item.question}</h3>
                <div>
                  <p>{item.answer}</p>
                  <nav class="fact-source-links" aria-label={`${item.question}的官方来源`}>
                    {item.sources.map((source) => (
                      <a class="text-link" href={source.url} target="_blank" rel="noreferrer">
                        {source.label} <ArrowRight size={14} aria-hidden="true" />
                      </a>
                    ))}
                  </nav>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {featuredActionLinks.length > 0 && (
        <section class="panel" aria-labelledby="featured-state-actions">
          <h2 id="featured-state-actions">{state.nameZh} 常用办理入口</h2>
          <p class="section-intro">续期、预约、邮寄查询和语言协助分属不同政府页面，请按自己的业务直接进入。</p>
          <div class="link-table">
            {featuredActionLinks.map((link, index) => (
              <div class="action-row">
                <div>
                  <strong>{link.label}</strong>
                  <p>{link.description}</p>
                </div>
                <OfficialLinkButton href={link.url} label="打开官方页" variant={index === 0 ? 'primary' : 'secondary'} />
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="panel fact-check-panel" aria-labelledby="state-evidence-heading">
        <h2 id="state-evidence-heading">本州办事要点</h2>
        <p class="section-intro">按事项查看州别要求，并直接进入相关政府页面。</p>
        <StateEvidenceList items={coreEvidence} ordered />
      </section>

      <section class="panel">
        <h2>三类入口怎么分</h2>
        <div class="comparison-table" role="table" aria-label={`${state.nameZh} DMV 办理入口对比`}>
          <div class="comparison-row comparison-head" role="row">
            <span role="columnheader">入口类型</span>
            <span role="columnheader">适合情况</span>
            <span role="columnheader">下一步</span>
          </div>
          {serviceComparisonRows.map((row) => (
            <div class="comparison-row" role="row">
              <strong role="cell">{row.label}</strong>
              <p role="cell">{row.use}</p>
              <p role="cell">{row.next}</p>
            </div>
          ))}
        </div>
      </section>

      {detailEvidence.length > 0 && (
        <section class="panel editorial-panel">
          <h2>本州办事细节</h2>
          <p class="section-intro">这些细节用于处理材料、期限、线上资格和州别例外；每条都保留对应政府入口。</p>
          <StateEvidenceList items={featuredDetailEvidence} />
          {additionalDetailEvidence.length > 0 && (
            <details class="state-evidence-more">
              <summary>查看其余 {additionalDetailEvidence.length} 条州别细节与来源</summary>
              <StateEvidenceList items={additionalDetailEvidence} />
            </details>
          )}
        </section>
      )}

      {accessStatus && (
        <section class:list={['panel', 'access-panel', accessStatus.tone]}>
          <div class="access-panel-heading">
            <h2>官方入口状态</h2>
            <span class={`status-chip ${accessStatus.tone}`}>{accessStatus.label}</span>
          </div>
          <p>{accessStatus.note}</p>
          {accessStatus.fallbackUrl && (
            <div class="access-panel-actions">
              <OfficialLinkButton href={accessStatus.fallbackUrl} label={accessStatus.fallbackLabel || '备用官方入口'} />
            </div>
          )}
        </section>
      )}

      <section class="panel">
        <h2>去办理前先准备</h2>
        <ul class="check-list">
          <li>先确认业务类型：REAL ID、首次驾照、续期、补证、地址变更、外州转入或车辆业务。</li>
          <li>准备当前驾照、ID 或车辆文件，并确认 {state.agency} 记录中的姓名和地址是否正确。</li>
          <li>涉及身份、SSN、居住地址或姓名变化时，进入对应材料页核对原件、认证副本和文件日期。</li>
          <li>保存预约确认、线上申请编号、付款收据和临时凭证；最终要求以官方系统为准。</li>
        </ul>
      </section>

      {remainingActionLinks.length > 0 && <section class="panel" id="official-entry">
        <h2>{featuredActionLinks.length > 0 ? '其他官方入口' : '官方入口'}</h2>
        <div class="link-table">
          {remainingActionLinks.map((link, index) => (
            <div class="action-row">
              <div>
                <strong>{link.label}</strong>
                <p>{link.description}</p>
              </div>
              <OfficialLinkButton href={link.url} label={index === 0 ? '打开官方页' : '打开'} variant={index === 0 ? 'primary' : 'secondary'} />
            </div>
          ))}
        </div>
      </section>}

      <section class="panel">
        <h2>常见问题</h2>
        <div class="faq-list">
          {overviewFaqs.map((faq) => (
            <div class="faq-item">
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>

      <EditorialDisclosure />
      <SourceList sources={officialSources} />
    </article>

    <aside class="sidebar" aria-label="侧边栏">
      <div class="panel">
        <h2>{state.nameZh} 快速入口</h2>
        <div class="quick-actions">
          <a class="button-link primary" href={`/states/${state.id}/real-id/`}>REAL ID 清单 <ArrowRight size={16} aria-hidden="true" /></a>
          {state.id === 'georgia' && (
            <a class="button-link secondary" href="/practice-tests/georgia/">中文笔试练习 <ArrowRight size={16} aria-hidden="true" /></a>
          )}
          <OfficialLinkButton href={state.agencyUrl} label={state.agency} />
        </div>
      </div>
      <div class="panel">
        <h2>相关专题</h2>
        <ul class="plain-list">
          {relatedTopics.map((topic) => (
            <li><a class="text-link" href={`/topics/${topic.slug}/`}>{topic.title} <ArrowRight size={15} aria-hidden="true" /></a></li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

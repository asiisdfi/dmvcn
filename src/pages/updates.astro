---
import { ArrowRight } from '@lucide/astro/icons';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="更多办事内容"
  description="继续浏览 DMV中文办事库的州指南、办事事项、政府入口表和中文驾照练习。"
>
  <section class="page-hero">
    <div class="section">
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>更多内容</span></nav>
      <p class="eyebrow">更多内容</p>
      <h1>继续查找 DMV 办事信息</h1>
      <p class="lead">可以按州、按事项或按政府服务入口继续浏览。</p>
    </div>
  </section>

  <section class="section">
    <div class="directory-link-list">
      <a href="/states/"><span><strong>50 州指南</strong><small>州 DMV、驾照、州身份证和 REAL ID。</small></span><ArrowRight size={17} aria-hidden="true" /></a>
      <a href="/topics/"><span><strong>事项大全</strong><small>材料、步骤、常见问题和州别差异。</small></span><ArrowRight size={17} aria-hidden="true" /></a>
      <a href="/directories/"><span><strong>政府入口表</strong><small>预约、考试、材料和线上服务入口。</small></span><ArrowRight size={17} aria-hidden="true" /></a>
      <a href="/practice-tests/"><span><strong>中文笔试练习</strong><small>按州练习并查看答案解释。</small></span><ArrowRight size={17} aria-hidden="true" /></a>
    </div>
  </section>
</BaseLayout>

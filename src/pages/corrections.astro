---
import { Mail } from '@lucide/astro/icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/content';

const contactEmail = SITE.contactEmail.trim();
const hasContactEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(contactEmail);
---

<BaseLayout
  title="内容纠错"
  description="向 DMV中文办事库反馈页面错误、失效链接或政府办理入口变化。"
>
  <section class="page-hero">
    <div class="section">
      <nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span>/</span><span>内容纠错</span></nav>
      <p class="eyebrow">内容纠错</p>
      <h1>反馈页面问题</h1>
      <p class="lead">请附上页面地址、具体位置和相关政府链接，方便快速定位。</p>
    </div>
  </section>

  <section class="section policy-layout">
    <div class="article-stack">
      <section class="panel">
        <div class="policy-heading"><Mail size={22} aria-hidden="true" /><h2>发送邮件</h2></div>
        {hasContactEmail ? (
          <p><a class="text-link" href={`mailto:${contactEmail}?subject=DMV中文办事库内容纠错`}>{contactEmail}</a></p>
        ) : (
          <p>联系邮箱将在配置后显示。</p>
        )}
      </section>
      <section class="panel">
        <h2>邮件里写什么</h2>
        <ul class="check-list">
          <li>页面 URL 和需要修改的句子或链接。</li>
          <li>对应州和办事事项。</li>
          <li>相关政府页面、表格或公告地址。</li>
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>

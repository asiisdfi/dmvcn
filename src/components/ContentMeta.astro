---
import { UserRound } from '@lucide/astro/icons';
import { EDITORIAL_AUTHOR } from '../data/editorial';

type Props = {
  publishedAt: string;
  modifiedAt: string;
  reviewedAt: string;
};

Astro.props as Props;
---

<div class="content-meta" aria-label="文章编辑信息">
  <p class="content-byline">
    <UserRound size={16} aria-hidden="true" />
    <a href={EDITORIAL_AUTHOR.path} rel="author">DMVCN 官方整理</a>
  </p>
</div>
